---
import "../styles/globals.css";
import "@fontsource/instrument-serif";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/inter/opsz-italic.css";
import { ClientRouter } from "astro:transitions";
import Footer from "~/components/common/footer.astro";
import Lightbox from "~/components/common/lightbox.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <Footer />
    <Lightbox />
    <div class="fixed bottom-4 right-4 z-50 bg-foreground text-background text-xs font-medium px-3 py-1.5 rounded-full select-none pointer-events-none">
      WIP
    </div>
    <script>
      // Browsers don't honor the autoplay attribute on videos swapped in by
      // the ClientRouter, so kick them off manually after each navigation.
      document.addEventListener("astro:page-load", () => {
        document.querySelectorAll<HTMLVideoElement>("video[autoplay]").forEach((video) => {
          video.play().catch(() => {});
        });
      });
    </script>
  </body>
</html>
