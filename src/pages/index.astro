---
import Layout from "../layouts/Layout.astro";
import Container from "~/components/common/container.astro";
import WorkCard from "~/components/common/work-card.astro";
import { getSortedWorks } from "~/lib/works";

const works = await getSortedWorks();
---

<Layout
  title="works | advtszn"
  description="Selected works by advtszn — products, tools, and sites built end to end."
>
  <main>
    <Container>
      <div class="space-y-12">
        <h1 class="font-heading font-medium text-4xl uppercase">
          works <span
            class="text-xl normal-case text-muted-foreground font-medium font- hover:text-foreground transition-colors duration-150"
            ><a href="https://advtszn.xyz" target="_blank">by advtszn</a></span
          >
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-x-4">
          {works.map((work) => <WorkCard work={work} loading="eager" />)}
        </div>
      </div>
    </Container>
  </main>
</Layout>
