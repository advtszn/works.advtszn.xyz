---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Container from "~/components/common/container.astro";
import { Image } from "astro:assets";

const works = await getCollection("work");

const formatDate = (date: Date): string => {
  const month = String(date.getMonth() + 1).padStart(2, "0");
  return `${month}/${date.getFullYear()}`;
};
---

<Layout>
  <main>
    <Container>
      <div class="space-y-6">
        <h1 class="font-serif text-4xl italic md:text-6xl">works</h1>
        <div class="border-t w-full"></div>
        <div class="grid grid-cols-2 gap-6">
          {
            works.map((work) => (
              <a href={`/${work.id}`} class="space-y-4">
                <Image
                  src={work.data.thumbnail}
                  width={1024}
                  height={1024}
                  alt={work.data.title}
                />
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <h2 class="font-serif text-3xl">
                      {work.data.title.toUpperCase()}
                    </h2>
                    <p class="text-sm text-muted-foreground">
                      {formatDate(work.data.date)}
                    </p>
                  </div>
                  <p class="text-sm text-muted-foreground font-medium">
                    {work.data.type} • {work.data.role.join(",")}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </Container>
  </main>
</Layout>
