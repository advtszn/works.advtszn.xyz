---
import Layout from "../layouts/Layout.astro";
import Container from "~/components/common/container.astro";

const works = [
	{
		slug: "superbai",
		title: "SUPERBAI",
		type: "freelance",
		role: "web design and development",
		thumbnail: "/images/superbai/dashboard-main.png",
	},
	{
		slug: "oilstream-solutions",
		title: "Oilstream Solutions",
		type: "freelance",
		role: "web design and development",
		thumbnail: "/images/oilstream-solutions/ipad-hero.png",
	},
];
---

<Layout>
  <main>
    <Container>
      <div class="space-y-12">
        <h1 class="font-serif font-medium text-4xl uppercase">
          works <span
            class="text-xl normal-case text-muted-foreground font-medium font- hover:text-foreground transition-colors duration-150"
            ><a href="https://advtszn.xyz" target="_blank">by advtszn</a></span
          >
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            works.map((work) => (
              <a href={`/${work.slug}`} class="space-y-4 group">
                <div class="aspect-video rounded group">
                  <img
                    src={work.thumbnail}
                    class="h-full w-full object-cover rounded grayscale group-hover:grayscale-0 transition-all duration-500"
                    alt={work.title}
                  />
                </div>
                <div class="space-y-1">
                  <h2 class="font-serif uppercase text-xl font-medium">
                    {work.title}
                  </h2>
                  <p class="text-muted-foreground font-medium">
                    {work.type} // {work.role}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </Container>
  </main>
</Layout>
