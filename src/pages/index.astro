---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Container from "~/components/common/container.astro";
import { Image } from "astro:assets";

const works = (await getCollection("work")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout>
  <main>
    <Container>
      <div class="space-y-12">
        <h1 class="font-serif font-medium text-4xl uppercase">
          works <span
            class="text-xl normal-case text-muted-foreground font-medium font- hover:text-foreground transition-colors duration-150"
            ><a href="https://advtszn.xyz" target="_blank">by advtszn</a></span
          >
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            works.map((work) => (
              <a href={`/${work.id}`} class="space-y-4 group">
                <div class="aspect-video rounded group">
                  <Image
                    src={work.data.thumbnail}
                    width={1024}
                    height={576}
                    class="h-full w-full object-cover rounded pointer-fine:grayscale pointer-fine:group-hover:grayscale-0 transition-all duration-500"
                    alt={work.data.title}
                    loading="eager"
                  />
                </div>
                <div class="space-y-1">
                  <h2 class="font-serif uppercase text-xl font-medium">
                    {work.data.title}
                  </h2>
                  <p class="text-muted-foreground font-medium">
                    {work.data.category} • {work.data.role}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </Container>
  </main>
</Layout>
