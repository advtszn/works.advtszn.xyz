---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "../layouts/Layout.astro";
import Container from "~/components/common/container.astro";
import { ArrowLeft } from "lucide-astro";

export const getStaticPaths = (async () => {
	const works = await getCollection("work");
	return works.map((work) => ({
		params: { slug: work.id },
		props: { work },
	}));
}) satisfies GetStaticPaths;

const { work } = Astro.props;
const { Content } = await render(work);

const formatDate = (date: Date): string => {
	const month = String(date.getMonth() + 1).padStart(2, "0");
	return `${month}/${date.getFullYear()}`;
};
---

<Layout>
  <main>
    <Container>
      <div class="space-y-6">
        <a href="/" class="text-muted-foreground flex text-sm items-center pt-2">
          <ArrowLeft size={16} className="mr-1.5" /> Back to works
        </a>
        <div class="flex items-center justify-between mb-12"><h1 class="uppercase text-3xl font-serif font-medium ">{work.data.title}</h1>
        <p class="font-medium text-sm text-muted-foreground">{formatDate(work.data.date)}</p></div>

        <div class="flex flex-col gap-12 md:flex-row items-start justify-between">
          <div class="md:w-1/2">
            <div class="flex gap-6 md:gap-12 flex-col">
              <div class="space-y-1">
                <h2 class="text-lg font-serif uppercase font-medium">Timeline</h2>
                <p class="text-muted-foreground">{work.data.timeline ?? "—"}</p>
              </div>
              <div class="space-y-1">
                <h2 class="text-lg font-serif uppercase font-medium">Live</h2>
                <p class="text-muted-foreground">
                  {work.data.url ? (
                    <a href={work.data.url} target="_blank" class="underline underline-offset-4 hover:text-foreground transition-colors">
                      {work.data.url.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                    </a>
                  ) : "Not available"}
                </p>
              </div>
              <div class="space-y-1">
                <h2 class="text-lg font-serif uppercase font-medium">Tech</h2>
                <p class="text-muted-foreground">{work.data.tech.join(", ")}</p>
              </div>
            </div>
          </div>

          <div class="md:w-1/2">
            <div class="flex gap-6 md:gap-12 flex-col">
              {work.data.overview && (
                <div class="space-y-1">
                  <h2 class="text-lg font-serif uppercase font-medium">Overview</h2>
                  <p class="text-muted-foreground">{work.data.overview}</p>
                </div>
              )}
              {work.data.contribution && (
                <div class="space-y-1">
                  <h2 class="text-lg font-serif uppercase font-medium">What I Built</h2>
                  <p class="text-muted-foreground">{work.data.contribution}</p>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </Container>

    <Container>
      <article class="mdx space-y-6">
        <Content />
      </article>
    </Container>
  </main>
</Layout>

<style>
  .mdx :global(a) {
    padding: 2px 4px;
    background-color: var(--color-muted);
    color: var(--color-muted-foreground);
  }

  .mdx :global(h1),
  .mdx :global(h2),
  .mdx :global(h3),
  .mdx :global(h4),
  .mdx :global(h5),
  .mdx :global(h6) {
    font-family: var(--font-serif);
    line-height: 1;
    margin-top: 2.5rem;
    text-transform: uppercase;
    font-weight: 500;
  }

  .mdx :global(h1) { font-size: 1.875rem; }
  .mdx :global(h2) { font-size: 1.5rem; }
  .mdx :global(h3) { font-size: 1.25rem; }
  .mdx :global(h4) { font-size: 1.125rem; }
  .mdx :global(h5) { font-size: 1rem; }
  .mdx :global(h6) { font-size: 1rem; }

  .mdx :global(p) {
    font-family: var(--font-sans);
    color: var(--color-muted-foreground);
    font-weight: 500;
    line-height: 150%;
    font-size: 16px;
  }

  @media (min-width: 768px) {
    .mdx :global(p) {
      font-size: 18px;
    }
  }
</style>
