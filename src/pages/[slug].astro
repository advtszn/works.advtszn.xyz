---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "../layouts/Layout.astro";
import Container from "~/components/common/container.astro";
import { Image } from "astro:assets";
import { ArrowLeft } from "lucide-astro";

export const getStaticPaths = (async () => {
  const works = await getCollection("work");
  works.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: {
      work,
      others: [1, 2, 3]
        .map((offset) => works[(i + offset) % works.length])
        .filter((other) => other.id !== work.id),
    },
  }));
}) satisfies GetStaticPaths;

const { work, others } = Astro.props;
const { Content } = await render(work);

const formatDate = (date: Date): string => {
  const month = String(date.getMonth() + 1).padStart(2, "0");
  return `${month}/${date.getFullYear()}`;
};
---

<Layout>
  <main>
    <Container>
      <div class="space-y-6">
        <a
          href="/"
          class="text-muted-foreground flex text-sm items-center pt-2"
        >
          <ArrowLeft size={16} className="mr-1.5" /> Back to works
        </a>
        <div class="flex items-center justify-between mb-12">
          <h1 class="uppercase text-3xl font-serif font-medium">
            {work.data.title}
          </h1>
          <p class="font-medium text-sm text-muted-foreground">
            {formatDate(work.data.date)}
          </p>
        </div>

        <div
          class="flex flex-col gap-12 md:flex-row items-start justify-between"
        >
          <div class="md:w-1/2">
            <div class="flex gap-6 md:gap-12 flex-col">
              <div class="space-y-1">
                <h2 class="text-lg font-serif uppercase font-medium">
                  Timeline
                </h2>
                <p class="text-muted-foreground">{work.data.timeline ?? "—"}</p>
              </div>
              <div class="space-y-1">
                <h2 class="text-lg font-serif uppercase font-medium">Live</h2>
                <p class="text-muted-foreground">
                  {
                    work.data.url ? (
                      <a
                        href={work.data.url}
                        target="_blank"
                        class="underline underline-offset-4 hover:text-foreground transition-colors"
                      >
                        {work.data.url
                          .replace(/^https?:\/\//, "")
                          .replace(/\/$/, "")}
                      </a>
                    ) : (
                      "Not available"
                    )
                  }
                </p>
              </div>
              <div class="space-y-1">
                <h2 class="text-lg font-serif uppercase font-medium">Tech</h2>
                <p class="text-muted-foreground">{work.data.tech.join(", ")}</p>
              </div>
            </div>
          </div>

          <div class="md:w-1/2">
            <div class="flex gap-6 md:gap-12 flex-col">
              <div class="space-y-1">
                <h2 class="text-lg font-serif uppercase font-medium">
                  Overview
                </h2>
                <p class="text-muted-foreground">{work.data.overview}</p>
              </div>
              <div class="space-y-1">
                <h2 class="text-lg font-serif uppercase font-medium">
                  What I Built
                </h2>
                <p class="text-muted-foreground">{work.data.contribution}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>

    <Container>
      <article class="mdx space-y-6 mb-20">
        <Content />
      </article>
      {
        others.length > 0 && (
          <div class="mb-20 py-10 border-t space-y-6">
            <h2 class="font-serif uppercase text-2xl font-medium">
              More works
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-4">
              {others.map((other) => (
                <a href={`/${other.id}`} class="space-y-4 group">
                  <div class="aspect-video rounded group">
                    <Image
                      src={other.data.thumbnail}
                      width={1024}
                      height={576}
                      class="h-full w-full object-cover rounded pointer-fine:grayscale pointer-fine:group-hover:grayscale-0 transition-all duration-500"
                      alt={other.data.title}
                      loading="lazy"
                    />
                  </div>
                  <div class="space-y-0.5">
                    <h3 class="font-serif uppercase text-lg font-medium">
                      {other.data.title}
                    </h3>
                    <p class="text-muted-foreground font-medium text-sm">
                      {other.data.category} • {other.data.role}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </Container>
  </main>
</Layout>

<style>
  .mdx :global(a) {
    padding: 2px 4px;
    background-color: var(--color-muted);
    color: var(--color-muted-foreground);
  }

  .mdx :global(h1),
  .mdx :global(h2),
  .mdx :global(h3),
  .mdx :global(h4),
  .mdx :global(h5),
  .mdx :global(h6) {
    font-family: var(--font-serif);
    line-height: 1;
    margin-top: 2.5rem;
    text-transform: uppercase;
    font-weight: 500;
  }

  .mdx :global(h1) {
    font-size: 1.875rem;
  }
  .mdx :global(h2) {
    font-size: 1.5rem;
  }
  .mdx :global(h3) {
    font-size: 1.25rem;
  }
  .mdx :global(h4) {
    font-size: 1.125rem;
  }
  .mdx :global(h5) {
    font-size: 1rem;
  }
  .mdx :global(h6) {
    font-size: 1rem;
  }

  .mdx :global(p) {
    font-family: var(--font-sans);
    color: var(--color-muted-foreground);
    font-weight: 500;
    line-height: 150%;
    font-size: 16px;
  }

  .mdx :global(ul),
  .mdx :global(ol) {
    font-family: var(--font-sans);
    color: var(--color-muted-foreground);
    font-weight: 500;
    line-height: 150%;
    font-size: 16px;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mdx :global(ul) {
    list-style-type: disc;
  }

  .mdx :global(ol) {
    list-style-type: decimal;
  }

  .mdx :global(li) :global(p) {
    display: inline;
  }

  @media (min-width: 768px) {
    .mdx :global(p),
    .mdx :global(ul),
    .mdx :global(ol) {
      font-size: 18px;
    }
  }
</style>
